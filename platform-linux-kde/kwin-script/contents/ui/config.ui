<?xml version="1.0" encoding="UTF-8"?>
<!-- UI nativa da config do KWin Script. Cada widget tem objectName = kcfg_<name>, fazendo o
     binding automático com as entradas de contents/config/main.xml (KConfigXT). -->
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_enabled">
     <property name="text">
      <string>Enable tiling (master switch; shortcut: Meta+Shift+Y)</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="labelGap">
     <property name="text">
      <string>Spacing (between windows and screen edge, px):</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="kcfg_gap">
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>100</number></property>
     <property name="maximumWidth"><number>80</number></property>
     <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_activeBorder">
     <property name="text">
      <string>Highlight the focused window with a border</string>
     </property>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="labelBorderColor">
     <property name="text">
      <string>Border color:</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="KColorButton" name="kcfg_borderColor"/>
   </item>
   <item row="4" column="0">
    <widget class="QLabel" name="labelBorderWidth">
     <property name="text">
      <string>Border thickness (px):</string>
     </property>
    </widget>
   </item>
   <item row="4" column="1">
    <widget class="QSpinBox" name="kcfg_borderWidth">
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>20</number></property>
     <property name="maximumWidth"><number>80</number></property>
     <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
    </widget>
   </item>
   <item row="5" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_roundedCorners">
     <property name="text">
      <string>Rounded corners (requires KWin's native corners effect)</string>
     </property>
    </widget>
   </item>
   <item row="6" column="0">
    <widget class="QLabel" name="labelCornerRadius">
     <property name="text">
      <string>Corner radius (px):</string>
     </property>
    </widget>
   </item>
   <item row="6" column="1">
    <widget class="QSpinBox" name="kcfg_cornerRadius">
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>50</number></property>
     <property name="maximumWidth"><number>80</number></property>
     <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
    </widget>
   </item>
   <item row="9" column="0">
    <widget class="QLabel" name="labelOuterGap">
     <property name="text">
      <string>Outer spacing at the screen edge (px; -1 = same as spacing):</string>
     </property>
    </widget>
   </item>
   <item row="9" column="1">
    <widget class="QSpinBox" name="kcfg_outerGap">
     <property name="minimum"><number>-1</number></property>
     <property name="maximum"><number>100</number></property>
     <property name="maximumWidth"><number>80</number></property>
     <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
    </widget>
   </item>
   <item row="10" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_smartGaps">
     <property name="text">
      <string>Smart gaps: no spacing when a single window is on the workspace</string>
     </property>
    </widget>
   </item>
   <item row="11" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_focusInsert">
     <property name="text">
      <string>Open new windows next to the focused window</string>
     </property>
    </widget>
   </item>
   <item row="7" column="0" colspan="2">
    <widget class="QLabel" name="labelIgnoreList">
     <property name="text">
      <string>Windows ignored by tiling (class/id, or title:text, e.g. obs, title:Picture-in-Picture):</string>
     </property>
    </widget>
   </item>
   <item row="8" column="0" colspan="2">
    <widget class="KEditListWidget" name="kcfg_ignoreList"/>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>KColorButton</class>
   <extends>QPushButton</extends>
   <header>kcolorbutton.h</header>
  </customwidget>
  <customwidget>
   <class>KEditListWidget</class>
   <extends>QWidget</extends>
   <header>keditlistwidget.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
