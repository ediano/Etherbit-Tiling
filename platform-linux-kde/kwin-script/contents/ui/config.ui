<?xml version="1.0" encoding="UTF-8"?>
<!-- UI nativa da config do KWin Script. Cada widget tem objectName = kcfg_<name>, fazendo o
     binding automático com as entradas de contents/config/main.xml (KConfigXT). -->
<ui version="4.0">
 <class>Form</class>
 <widget class="QWidget" name="Form">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="labelGap">
     <property name="text">
      <string>Espaçamento (entre janelas e da borda, px):</string>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QSpinBox" name="kcfg_gap">
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>200</number></property>
    </widget>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_activeBorder">
     <property name="text">
      <string>Destacar a janela focada com borda</string>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="labelBorderColor">
     <property name="text">
      <string>Cor da borda:</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="KColorButton" name="kcfg_borderColor"/>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="labelBorderWidth">
     <property name="text">
      <string>Espessura da borda (px):</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QSpinBox" name="kcfg_borderWidth">
     <property name="minimum"><number>0</number></property>
     <property name="maximum"><number>20</number></property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_autostart">
     <property name="text">
      <string>Iniciar o daemon com o sistema</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>KColorButton</class>
   <extends>QPushButton</extends>
   <header>kcolorbutton.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
