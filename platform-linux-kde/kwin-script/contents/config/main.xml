<?xml version="1.0" encoding="UTF-8"?>
<!-- KConfigXT: schema da config nativa do KWin Script. As chaves abaixo são lidas em runtime
     por readConfig('<name>', default) em contents/code/main.ts e editadas pela UI nativa
     (Configurações do Sistema → KWin Scripts → ⚙). Os valores ficam em ~/.config/kwinrc.
     Os defaults DEVEM casar com DEFAULT_CONFIG (e com Config::default() do daemon). -->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="">
    <entry name="enabled" type="Bool">
      <label>Ativar o tiling (chave geral)</label>
      <default>true</default>
    </entry>
    <entry name="gap" type="Int">
      <label>Espaçamento único: entre janelas e da borda da tela (px)</label>
      <default>8</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="activeBorder" type="Bool">
      <label>Destacar a janela focada com borda</label>
      <default>true</default>
    </entry>
    <entry name="borderColor" type="String">
      <label>Cor da borda da janela focada</label>
      <default>#5e81ac</default>
    </entry>
    <entry name="borderWidth" type="Int">
      <label>Espessura da borda (px)</label>
      <default>2</default>
      <min>0</min>
      <max>20</max>
    </entry>
    <entry name="roundedCorners" type="Bool">
      <label>Cantos arredondados (requer o efeito nativo de cantos do KWin)</label>
      <default>true</default>
    </entry>
    <entry name="cornerRadius" type="Int">
      <label>Raio dos cantos (px)</label>
      <default>12</default>
      <min>0</min>
      <max>50</max>
    </entry>
    <entry name="debug" type="Bool">
      <label>Logs detalhados no journal (diagnóstico): nº de janelas/retângulos por evento</label>
      <default>false</default>
    </entry>
  </group>
</kcfg>
