# ─────────────────────────────────────────────
#  Release  (artefatos gerados por packaging/build-linux-release.sh)
# ─────────────────────────────────────────────
/dist-release/
/etherbit-tiling-gnome.tar.gz
/etherbit-tiling-kde.tar.gz

# ─────────────────────────────────────────────
#  Rust / Cargo  (core + platform-linux-daemon/daemon)
# ─────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock: MANTIDO no versionamento.
# O workspace produz um binário (etherbit-tiling-daemon), então o lockfile
# deve ser commitado para builds reproduzíveis. NÃO ignorar.

# ─────────────────────────────────────────────
#  Node / Vite / TypeScript  (platform-linux-gnome/extension)
# ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Logs e caches de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Saída de compilação TypeScript
*.tsbuildinfo

# KWin Script (platform-linux-kde): o bundle IIFE é gerado pelo Vite ao lado dos
# fontes .ts em contents/code/ — artefato de build, NÃO versionado (como dist/ no GNOME).
/platform-linux-kde/kwin-script/contents/code/main.js

# Variáveis de ambiente
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
#  Swift / Xcode  (platform-macos)
# ─────────────────────────────────────────────
.build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Package.resolved

# ─────────────────────────────────────────────
#  Sistema operacional
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─────────────────────────────────────────────
#  Editores / IDEs
# ─────────────────────────────────────────────
# .vscode/ é versionado parcialmente para compartilhar config do Dev Container.
# Ignoramos apenas arquivos locais/voláteis:
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
